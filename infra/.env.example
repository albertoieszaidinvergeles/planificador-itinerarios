# ============================================================
# App 2 con Docker — copia este fichero a `infra/.env` y rellena.
#   Copy-Item .env.example .env
# `.env` está en .gitignore: NUNCA se sube a Git ni entra en las
# imágenes (.dockerignore). Aquí solo van nombres y placeholders.
# ============================================================

# --- IA (OpenRouter) ---
# Clave secreta: solo la recibe el contenedor del backend.
AI_API_KEY=pon-aqui-tu-clave
AI_MODEL=nvidia/nemotron-3.5-lightning:free
AI_TIMEOUT=20

# --- Clerk (instancia de desarrollo, pk_test_) ---
# Funciona en cualquier dirección, sin proxy ni clave secreta.
# Emisor del token: sin barra final y sin /.well-known/jwks.json.
CLERK_ISSUER=https://pon-aqui-tu-instancia.clerk.accounts.dev
# Claves públicas con las que el backend verifica la firma del token.
CLERK_JWKS_URL=https://pon-aqui-tu-instancia.clerk.accounts.dev/.well-known/jwks.json
# Publishable key: es pública y va en el navegador.
VITE_CLERK_PUBLISHABLE_KEY=pon-aqui-tu-clave-publica

# --- Dirección de la web ---
# En tu ordenador, sin HTTPS:
DOMINIO=http://localhost
# En EC2, con HTTPS automático (sustituye por la IP elástica, con guiones):
# DOMINIO=1-2-3-4.sslip.io
