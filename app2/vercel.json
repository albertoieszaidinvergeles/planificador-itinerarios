{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "echo skip",
  "framework": null,
  "functions": {
    "api/plan.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/plan", "destination": "/api/plan" },
    { "source": "/(.*)",     "destination": "/index.html" }
  ]
}
