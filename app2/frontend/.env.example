# ============================================================
# App 2 (frontend) — copia este fichero a `.env` y rellena.
#   Copy-Item .env.example .env
# Solo llegan al navegador las variables que empiezan por `VITE_`
# (regla de Vite). `.env` está en .gitignore: no se sube a Git.
# ============================================================

# Publishable key de Clerk (pk_test_…): ES PÚBLICA por diseño, va en el
# navegador. La secreta (sk_test_…) NUNCA se pone aquí: solo en el backend.
# Dashboard de Clerk → Configure → API keys → Publishable key.
VITE_CLERK_PUBLISHABLE_KEY=pon-aqui-tu-clave-publica

# URL base del backend. En local: http://127.0.0.1:8000
# En producción (Vercel) se deja VACÍA: el frontend llama a /api/plan
# en el mismo origen.
VITE_API_BASE_URL=http://127.0.0.1:8000
