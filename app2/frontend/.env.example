# ============================================================
# App 2 (frontend) — copia este fichero a `.env` y rellena.
#   cp .env.example .env
# Solo se exponen al navegador las variables que empiezan por
# `VITE_` (regla de Vite). Por eso la publishable key lleva ese
# prefijo y NO el de Next (`NEXT_PUBLIC_`), que es el que pone la
# guía de Clerk. `.env` está en .gitignore: no se sube a Git.
# ============================================================

# URL base del backend (pública; aquí solo valores de ejemplo, nunca secretos)
# Local: http://127.0.0.1:8000 · En Vercel: URL HTTPS del proyecto app2
VITE_API_BASE_URL=http://127.0.0.1:8000

# Publishable key de Clerk (pk_test_…): ES PÚBLICA por diseño, va en el
# navegador. La secreta (sk_test_…) NUNCA se pone aquí: solo en el backend.
# Dashboard Clerk → Configure → API keys → Publishable key.
VITE_CLERK_PUBLISHABLE_KEY=pon-aqui-tu-clave-publica
