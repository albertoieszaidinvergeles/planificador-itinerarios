# ============================================================
# App 2 (backend) — copia este fichero a `.env` y rellena.
#   cp .env.example .env
# `.env` está en .gitignore (raíz): NUNCA se sube a Git.
# Este .env.example sí se sube, pero SOLO con nombres y
# placeholders: nunca con claves reales.
# ============================================================

# ------------------------------------------------------------
# IA (OpenRouter) — igual que en App 1
# ------------------------------------------------------------

# Clave de OpenRouter (solo backend; nunca en el frontend ni en Git)
AI_API_KEY=pon-aqui-tu-clave

# Modelo gratuito de OpenRouter (termina en :free)
AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Segundos máximos de espera a la IA
AI_TIMEOUT=20

# ------------------------------------------------------------
# Servidor
# ------------------------------------------------------------

# Orígenes permitidos para CORS (URL del frontend), separados por comas
CORS_ORIGINS=http://localhost:5173

# Activa /docs, /redoc y /openapi.json. Solo en local: en Vercel NO se define.
DOCS_ACTIVOS=1

# ------------------------------------------------------------
# Clerk (SOLO App 2) — identidad externa, sin usuarios propios
# ------------------------------------------------------------

# Secret key (sk_test_…): Dashboard de Clerk → Configure → API keys →
# Secret key (botón Reveal). SOLO va en backend: ni en el frontend,
# ni en Git, ni en capturas. La pk_test_… (pública) va en el front.
CLERK_SECRET_KEY=pon-aqui-tu-clave-secreta

# Emisor esperado del session token (claim `iss`), con la barra final:
#   https://<tu-instancia>.clerk.accounts.dev     (instancia Development)
# Sale decodificando la parte tras `pk_test_` de tu publishable key
# (base64) o mirando el `iss` de cualquier token de sesión.
CLERK_ISSUER=https://pon-aqui-tu-instancia.clerk.accounts.dev

# Audiencia esperada (claim `aud`), si tu plantilla de token la define
# (app_…). Vacío = no se comprueba audiencia.
CLERK_AUDIENCE=
