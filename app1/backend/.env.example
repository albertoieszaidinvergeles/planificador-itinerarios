# Clave de OpenRouter (solo backend; nunca en el frontend ni en Git)
AI_API_KEY=pon-aqui-tu-clave
# Modelo gratuito de OpenRouter (termina en :free)
AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Segundos máximos de espera a la IA
AI_TIMEOUT=20
# Orígenes permitidos para CORS (URL del frontend), separados por comas
CORS_ORIGINS=http://localhost:5173
# Activa /docs, /redoc y /openapi.json. Solo en local: en Vercel NO se define.
DOCS_ACTIVOS=1